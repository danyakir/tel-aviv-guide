# Email settings — send from one address, receive at another

# The address recipients see in the "From" field
EMAIL_FROM=sender@gmail.com

# Your receiving address (where the weekend guide lands)
EMAIL_TO=you@outlook.com

# SMTP login (the account you send FROM)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@gmail.com       # usually same as EMAIL_FROM
SMTP_PASS=your-gmail-app-password # Gmail App Password, NOT your regular password

# Optional: set to Israel timezone explicitly
TZ=Asia/Jerusalem